# ── Servidor ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de datos ─────────────────────────────────────────────────
# Podés elegir una de tres formas de conectar (por prioridad):
#
# A) DATABASE_URL — lo que inyectan Railway / Neon / Supabase / Render
#    Deja el resto de las variables DB_* sin usar.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DB_SSL=true   # false para Postgres local sin SSL
#
# B) Postgres local (docker o instalado)
# DB_DIALECT=postgres
# DB_SERVER=localhost
# DB_PORT=5432
# DB_NAME=stocker
# DB_USER=postgres
# DB_PASSWORD=postgres
#
# C) SQL Server local (setup original de dev)
# DB_DIALECT=mssql
#DB_SERVER=localhost
#DB_PORT=1433
#DB_NAME=isumayorista
#DB_USER=sa
#DB_PASSWORD=cambiar
#DB_ENCRYPT=false
#DB_TRUST_CERT=true

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=cambiar-por-una-cadena-larga-aleatoria
JWT_EXPIRES_IN=7d

# ── Email (Gmail con App Password) ──────────────────────────────
# Requiere 2FA activo. Generar App Password en:
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=tu_email@gmail.com
MAIL_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Stocker <tu_email@gmail.com>"

# ── WhatsApp Meta Cloud API ───────────────────────────────────────
# Registrarse en https://developers.facebook.com y crear Meta App tipo Business.
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_API_VERSION=v22.0
# WHATSAPP_TEMPLATE_NAME=pedido_confirmado
# WHATSAPP_TEMPLATE_LANG=es_AR

# ── WhatsApp CallMeBot (fallback) ────────────────────────────────
# WHATSAPP_API_URL=https://api.callmebot.com/whatsapp.php
# WHATSAPP_API_KEY=

# ── PDFs ─────────────────────────────────────────────────────────
PDF_STORAGE_PATH=./storage/pdfs

# ── ARCA/AFIP (modo delegación) ─────────────────────────────────
# ARCA_MOCK=true → CAE simulado.
# Correr `npm run arca:generate-cert` para generar key + CSR.
ARCA_MOCK=true
ARCA_STOCKER_CUIT=
ARCA_CERT_PATH=./storage/arca/stocker.crt
ARCA_KEY_PATH=./storage/arca/stocker.key

# ── Consulta de CUIT (autocomplete clientes) ────────────────────
# Opcional. Ver documentación de arcaLookupService para APIs compatibles.
# CUIT_API_URL=
# CUIT_API_KEY=
# CUIT_API_AUTH_HEADER=Authorization

# ── CORS ─────────────────────────────────────────────────────────
# Dominios exactos separados por coma. En dev con ngrok podés
# dejarlo vacío (permite *.vercel.app, *.ngrok*, localhost).
# FRONTEND_URL=https://stocker.vercel.app,https://stocker.tudominio.com
