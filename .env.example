# ── Desarrollo ────────────────────────────────────────────────────
# El front siempre habla con la API por /api, mismo origen. Nunca apuntar
# directo al backend: sería cross-origin y el navegador descartaría la
# cookie de sesión (SameSite=Lax).
VITE_API_URL=/api

# A dónde reenvía el proxy de Vite en desarrollo.
VITE_DEV_API_TARGET=http://localhost:3000

# ── Producción (Railway) ──────────────────────────────────────────
# No se definen acá sino en las variables del servicio. server.js necesita:
#
#   API_INTERNAL_URL=http://<nombre-del-servicio-backend>.railway.internal:3000
#
# Esa URL sólo resuelve dentro del proyecto de Railway: es lo que permite
# que el backend no tenga dominio público.
