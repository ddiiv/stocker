
# ── Servidor ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── SQL Server (instancia local Linux) ────────────────────────────
# El servidor en Linux suele ser: localhost o 127.0.0.1
# Si usás autenticación Windows (AD) en Linux → cambiar encrypt a false
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=isumayorista
DB_USER=sa
DB_PASSWORD=Prototype69
# true en Azure, false en instancia local sin certificado
DB_ENCRYPT=false
# true si el certificado del server no es de una CA conocida
DB_TRUST_CERT=true

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=a3f9c2e1b8d47f6a0c5e3d2b9f1a4c7e8d2b6f3a9c1e4d7b0f2a5c8e1b3d6f9a2c4e7
JWT_EXPIRES_IN=7d

# ── Email (nodemailer) ───────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=dantolin45@gmail.com
MAIL_PASS=Prototype69@
MAIL_FROM="Stocker <tu_email@gmail.com>"

# ── WhatsApp (CallMeBot — gratuito) ──────────────────────────────
WHATSAPP_API_URL=https://api.callmebot.com/whatsapp.php
WHATSAPP_API_KEY=

# ── PDFs ─────────────────────────────────────────────────────────
PDF_STORAGE_PATH=./storage/pdfs

# ── ARCA/AFIP (Facturación Electrónica) ─────────────────────────
# ARCA_MOCK=true  → CAE simulado, sin llamadas reales (dev).
# ARCA_MOCK=false → integración real vía @afipsdk/afip.js.
#
# Modo delegación (Opción B): Stocker tiene UN certificado propio y cada
# cliente delega el servicio wsfe a nuestro CUIT desde su Administrador de
# Relaciones AFIP. Configurar acá los datos de Stocker:
#
#   1. Correr: `npm run arca:generate-cert` (genera .key + .csr).
#   2. Subir el .csr a AFIP → "Administrador de Certificados Digitales".
#   3. Bajar el .crt firmado a backend/storage/arca/stocker.crt.
#   4. Setear las 4 variables abajo y ARCA_MOCK=false.
#
ARCA_MOCK=true
ARCA_STOCKER_CUIT=
ARCA_CERT_PATH=
ARCA_KEY_PATH=

# ── Consulta de CUIT (autocomplete de clientes) ──────────────────
# Opcional. Si querés que al ingresar un CUIT se busque razón social/domicilio
# reales, configurá una API externa (registrándote en algún servicio gratuito).
# Sin esto, el sistema igual valida el CUIT localmente, extrae el DNI para
# personas físicas, y sugiere tipo de factura y de cliente.
# La URL debe contener {cuit} donde va el número. Ejemplos:
#   CUIT_API_URL=https://api.miproveedor.com/cuit/{cuit}
#   CUIT_API_KEY=tu-api-key
#   CUIT_API_AUTH_HEADER=Authorization    (default; puede ser "x-api-key", etc.)
# CUIT_API_URL=
# CUIT_API_KEY=
# CUIT_API_AUTH_HEADER=Authorization
